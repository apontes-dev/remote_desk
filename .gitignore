# Runtime state & transfer folders (created when a host runs)
**/rd_state.json
**/rd_state.json.tmp
**/shared/

# Bundled binaries you fetch locally (not source)
**/cloudflared.exe
portable-python/python/

# TLS material generated by the full server
full/cert.pem
full/key.pem

# Python / build caches
__pycache__/
*.pyc
*.obj
*.pdb
